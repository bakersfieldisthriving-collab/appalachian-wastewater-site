---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceRequestForm from "../components/ServiceRequestForm.astro";
import { business, serviceArea } from "../data/site";

const description =
  "Contact Appalachian Wastewater for septic pumping, inspections, emergency septic service, drain field diagnostics, grease trap pumping, and maintenance for East Tennessee properties.";

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: `Contact ${business.name}`,
  url: `${business.url}/contact/`,
  about: {
    "@type": "LocalBusiness",
    name: business.name,
    telephone: business.phone,
    email: business.email,
  },
};
---

<BaseLayout title="Contact Appalachian Wastewater" description={description} schema={schema}>
  <section class="page-hero">
    <span class="eyebrow">Contact</span>
    <h1>Request septic or wastewater service for your property.</h1>
    <p class="lead">
      Call for urgent septic problems, or use the quick request form for
      pumping, inspections, maintenance, grease trap pumping, and other service
      needs across East Tennessee properties.
    </p>
  </section>

  <section class="section">
    <div class="contact-grid">
      <div class="contact-panel">
        <ServiceRequestForm
          source="contact-page"
          heading="Tell us what is happening on site."
          intro="Use this form for homes, rural properties, restaurants, campgrounds, cabins, churches, rentals, small businesses, and light commercial properties."
        />
      </div>

      <aside class="contact-panel">
        <span class="eyebrow">Direct Contact</span>
        <h2>Reach Appalachian Wastewater.</h2>
        <p>
          For emergency septic service, call directly so we can understand the
          problem and help you decide what to do next.
        </p>
        <div class="contact-actions">
          <a class="button button-primary" href={business.phoneHref}>{business.phone}</a>
          <a class="button button-secondary" href={business.emailHref}>{business.email}</a>
        </div>

        <div class="contact-note">
          <strong>Emergency service</strong>
          <p>
            If sewage is backing up, drains are suddenly slowing, alarms are
            active, or odors are strong, calling is the fastest way to start the
            conversation.
          </p>
        </div>

        <div class="contact-note">
          <strong>What to expect</strong>
          <p>
            Share the city, property type, service need, symptoms, and access
            notes. Appalachian Wastewater will review the request and help
            identify the right next step.
          </p>
        </div>

        <div class="contact-note">
          <strong>Service area</strong>
          <ul class="mini-area-list">
            {serviceArea.map((area) => <li>{area}</li>)}
          </ul>
        </div>

        <div class="contact-note">
          <strong>Helpful details</strong>
          <p>
            Property address, tank access if known, service history, current
            symptoms, and whether the request is urgent.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
