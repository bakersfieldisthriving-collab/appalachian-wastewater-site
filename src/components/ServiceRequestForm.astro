---
import { business, services } from "../data/site";

interface Props {
  heading?: string;
  intro?: string;
  compact?: boolean;
  source?: string;
}

const {
  heading = "Request septic or wastewater service.",
  intro = "Share the basics and Appalachian Wastewater will follow up with the right next step.",
  compact = false,
  source = "site-request-form",
} = Astro.props;

const zapierWebhookUrl = import.meta.env.PUBLIC_ZAPIER_WEBHOOK_URL ?? "";
---

<form
  class:list={["request-form", compact && "request-form-compact"]}
  action={business.emailHref}
  method="post"
  enctype="text/plain"
  data-lead-form="service-request"
  data-lead-source={source}
  data-zapier-webhook={zapierWebhookUrl}
>
  <div class="form-heading">
    <span class="form-kicker">Service Request</span>
    <h2>{heading}</h2>
    <p>{intro}</p>
  </div>

  <div class="form-grid">
    <label>
      Name
      <input name="name" autocomplete="name" required />
    </label>

    <label>
      Phone
      <input name="phone" type="tel" autocomplete="tel" required />
    </label>

    <label>
      Email
      <input name="email" type="email" autocomplete="email" required />
    </label>

    <label>
      City
      <input name="city" autocomplete="address-level2" required />
    </label>

    <label class="form-wide">
      Service Needed
      <select name="service_needed" required>
        <option value="">Select a service</option>
        {services.map((service) => <option value={service.title}>{service.title}</option>)}
        <option value="Not sure">Not sure yet</option>
      </select>
    </label>

    <fieldset class="emergency-field">
      <legend>Emergency?</legend>
      <label>
        <input type="radio" name="emergency" value="Yes" />
        Yes
      </label>
      <label>
        <input type="radio" name="emergency" value="No" checked />
        No
      </label>
    </fieldset>

    <label class="form-wide">
      Notes
      <textarea
        name="notes"
        placeholder="Tell us what is happening, property type, access notes, timing, or any alarms/backups."
      ></textarea>
    </label>
  </div>

  <div class="form-actions">
    <button class="button button-primary" type="submit" data-submit-label="Request Service">
      Request Service
    </button>
    <a class="button button-secondary" href={business.phoneHref}>Call Now</a>
  </div>

  <p class="form-status" data-form-status aria-live="polite"></p>

  <p class="form-footnote">
    For urgent septic problems, call <a href={business.phoneHref}>{business.phone}</a>.
  </p>
</form>

<script>
  const forms = document.querySelectorAll("[data-lead-form='service-request']");

  const getFieldValue = (form, name) => {
    const field = form.elements.namedItem(name);
    if (!field) return "";
    if (field instanceof RadioNodeList) return field.value;
    return field.value;
  };

  const getWebhookDebugTarget = (webhookUrl) => {
    try {
      const url = new URL(webhookUrl);
      return `${url.origin}${url.pathname}`;
    } catch {
      return "Invalid webhook URL";
    }
  };

  const setStatus = (status, message, state) => {
    if (!status) return;
    status.textContent = message;
    status.classList.remove("is-success", "is-error");
    if (state) status.classList.add(state);
  };

  const postJsonToZapier = async (webhookUrl, payload) => {
    console.info("Submitting lead form to Zapier webhook.", {
      target: getWebhookDebugTarget(webhookUrl),
      contentType: "application/json",
      payload,
    });

    return fetch(webhookUrl, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify(payload),
    });
  };

  const postNoCorsFallback = async (webhookUrl, payload) => {
    console.warn(
      "Primary Zapier JSON request failed. Trying no-cors fallback for browser webhook delivery.",
      {
        target: getWebhookDebugTarget(webhookUrl),
        contentType: "text/plain",
        payload,
      },
    );

    return fetch(webhookUrl, {
      method: "POST",
      mode: "no-cors",
      headers: {
        "Content-Type": "text/plain;charset=UTF-8",
      },
      body: JSON.stringify(payload),
    });
  };

  forms.forEach((form) => {
    if (form.dataset.zapierReady === "true") return;
    form.dataset.zapierReady = "true";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const status = form.querySelector("[data-form-status]");
      const submitButton = form.querySelector("button[type='submit']");
      const defaultLabel = submitButton?.dataset.submitLabel || "Request Service";
      const webhookUrl = form.dataset.zapierWebhook || "";

      setStatus(status, "", undefined);

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (!webhookUrl) {
        console.error(
          "Missing PUBLIC_ZAPIER_WEBHOOK_URL. Lead form submissions cannot be sent to Zapier.",
        );
        setStatus(
          status,
          "Online requests are not connected yet. Please call (423) 470-3769 or email tyler@appalachianwastewater.com.",
          "is-error",
        );
        return;
      }

      const submittedAt = new Date().toISOString();
      const emergency = getFieldValue(form, "emergency");
      const payload = {
        Timestamp: submittedAt,
        Source: "Website Form",
        Name: getFieldValue(form, "name"),
        Phone: getFieldValue(form, "phone"),
        Email: getFieldValue(form, "email"),
        City: getFieldValue(form, "city"),
        "Service Needed": getFieldValue(form, "service_needed"),
        "Emergency?": emergency,
        Notes: getFieldValue(form, "notes"),
        Status: "New",
        Priority: emergency === "Yes" ? "Urgent" : "Normal",
        "Assigned To": "Tyler",
        "Follow Up Date": "",
        "Scheduled Date": "",
        "Job Value": "",
        Outcome: "",
        "Page URL": window.location.href,
        "Submitted At": submittedAt,
      };

      try {
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = "Sending...";
        }
        setStatus(status, "Sending your request...", undefined);

        let response;

        try {
          response = await postJsonToZapier(webhookUrl, payload);
        } catch (primaryError) {
          console.error("Primary Zapier JSON request failed.", {
            error: primaryError,
            target: getWebhookDebugTarget(webhookUrl),
            payload,
          });
          response = await postNoCorsFallback(webhookUrl, payload);
        }

        if (response.type === "opaque") {
          console.info(
            "Zapier fallback request was accepted by the browser as an opaque no-cors response.",
            {
              target: getWebhookDebugTarget(webhookUrl),
              payload,
            },
          );
        } else if (!response.ok) {
          const responseText = await response.text().catch(() => "");
          throw new Error(
            `Zapier webhook returned ${response.status} ${response.statusText}. ${responseText}`,
          );
        } else {
          console.info("Zapier webhook accepted lead form submission.", {
            status: response.status,
            target: getWebhookDebugTarget(webhookUrl),
          });
        }

        form.reset();
        setStatus(
          status,
          "Request sent. Appalachian Wastewater will review your information and follow up.",
          "is-success",
        );
      } catch (error) {
        console.error("Lead form submission failed after all attempts.", {
          error,
          target: getWebhookDebugTarget(webhookUrl),
          payload,
        });
        setStatus(
          status,
          "Something went wrong sending the request. Please call (423) 470-3769 or try again.",
          "is-error",
        );
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = defaultLabel;
        }
      }
    });
  });
</script>
