---
interface Props {
  title: string;
  description: string;
  index?: number;
}

const { title, description, index = 0 } = Astro.props;
---

<article class="service-card">
  <div class="service-number">{String(index + 1).padStart(2, "0")}</div>
  <h3>{title}</h3>
  <p>{description}</p>
</article>
