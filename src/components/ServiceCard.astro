---
interface Props {
  title: string;
  description: string;
  index?: number;
  href?: string;
}

const { title, description, index = 0, href } = Astro.props;
---

<article class="service-card">
  <div class="service-number">{String(index + 1).padStart(2, "0")}</div>
  <h3>{title}</h3>
  <p>{description}</p>
  {href && <a class="text-link" href={href}>Learn more</a>}
</article>
