---
import { business, navItems, services } from "../data/site";
---

<footer class="footer">
  <div class="footer-grid">
    <div>
      <a class="brand footer-brand" href="/" aria-label={`${business.name} home`}>
        <span class="brand-mark" aria-hidden="true">AW</span>
        <span>
          <strong>{business.name}</strong>
          <small>East Tennessee septic service</small>
        </span>
      </a>
      <p>
        Premium septic and wastewater service for homes, businesses, rural
        properties, cabins, churches, restaurants, rentals, and campgrounds
        across our East Tennessee service region.
      </p>
    </div>

    <div>
      <h2>Company</h2>
      <ul>
        {navItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2>Services</h2>
      <ul>
        {services.slice(0, 5).map((service) => <li><a href="/services/">{service.title}</a></li>)}
      </ul>
    </div>

    <div>
      <h2>Contact</h2>
      <ul>
        <li><a href={business.phoneHref}>{business.phone}</a></li>
        <li><a href={business.emailHref}>{business.email}</a></li>
        <li>{business.region}</li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <span>&copy; {new Date().getFullYear()} {business.name}. All rights reserved.</span>
    <span>Septic pumping. Inspections. Grease traps. Emergency response.</span>
  </div>
</footer>
