---
import { business, navItems } from "../data/site";

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <a class="brand" href="/" aria-label={`${business.name} home`}>
    <span class="brand-mark" aria-hidden="true">AW</span>
    <span>
      <strong>{business.name}</strong>
      <small>Septic & Wastewater Service</small>
    </span>
  </a>

  <nav aria-label="Primary navigation">
    {navItems.map((item) => (
      <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
        {item.label}
      </a>
    ))}
  </nav>

  <a class="header-call" href={business.phoneHref}>{business.phone}</a>
</header>
